# Copy to config/home.env (not tracked), or let ./scripts/setup.sh write it for you.
# Quote values that have spaces. Rebuild after a change: ./scripts/install-launcher.sh
TV=192.168.1.50:5555
TV_MODEL="TCL 55S450F"        # shown in Settings → About; setup.sh detects it
FIRE_OS=7.7.1.7               # shown in Settings → About; setup.sh detects it
NAME=Sam                      # empty for greetings without a name
APP_NAME="Sam Home"           # what the TV's app list shows
WEATHER_CITY=Austin           # shown on the home screen
WEATHER_PLACE="Austin, TX"    # shown on the screensaver
WEATHER_LAT=30.27
WEATHER_LON=-97.74
WEATHER_TZ=America/Chicago
UNITS=imperial                # imperial (°F, mph) or metric (°C, km/h); Settings can switch
# Optional local headlines topic: RSS or Atom links, space-separated. Empty = no local topic.
LOCAL_NEWS_NAME=Austin
LOCAL_NEWS_SUB="KUT, Austin Monitor"
LOCAL_NEWS_FEEDS=""
